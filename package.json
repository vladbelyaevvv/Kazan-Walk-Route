{
  "name": "kazan-walk-route",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.js",
    "experiments": "tsx src/experiments/run.mjs",
    "experiments:reproduce": "tsx src/experiments/run.mjs --offline",
    "analysis": "node src/analysis/analyze.mjs",
    "paper": "node src/analysis/paper.mjs",
    "audit": "node src/analysis/audit.mjs"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
